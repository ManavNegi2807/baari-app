# Baari settings. Copy this file to a new file named .env (same folder as package.json), fill it in, then restart with npm start.

# Password for the clinic desk (the username is always: staff)
STAFF_PASSWORD=choose-a-password

# --- WhatsApp Business (Meta Cloud API). Leave these empty to use manual mode. ---
# From developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# Name of your approved message template (see the steps for the template text).
# For a first test you can use: hello_world
WHATSAPP_TEMPLATE=appointment_reminder
WHATSAPP_TEMPLATE_LANG=en

# For patient replies (YES / NO). Any word you choose; paste the same word into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=baari-verify
# From your app's Settings > Basic > App secret (optional, makes replies tamper-proof)
WHATSAPP_APP_SECRET=

# Optional: turns on AI wording for the daily briefing and the patient visit helper.
# Without it, both still work using built-in rules. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Or use a Groq key instead (free tier at https://console.groq.com). Anthropic is used first if both are set.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_MODEL=claude-haiku-4-5

# Company site (http://localhost:5000/company): password for the "admin" login. If empty, a random one is printed once on first start.
COMPANY_PASSWORD=

# ---- Only when Baari runs on a server (see DEPLOY.md). Leave these out on your own computer. ----
# TRUST_PROXY=true
# PATIENT_HOST=book.yourdomain.com
# STAFF_HOST=app.yourdomain.com
# COMPANY_HOST=admin.yourdomain.com
# DATABASE_PATH=/var/lib/baari/baari.db

# Online payment for the patient priority plan (optional). Without these, patients pay at the clinic desk.
# Razorpay dashboard > Account & Settings > API keys. Use rzp_test_ keys first, then switch to live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard > Webhooks. Add https://YOUR-PATIENT-SITE/api/patient/pay/webhook, event payment.captured, and paste its secret here.
# This activates the plan even if the patient closes the page right after paying.
RAZORPAY_WEBHOOK_SECRET=
